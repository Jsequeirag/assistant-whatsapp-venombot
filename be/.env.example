# ─── IA (OpenAI-compatible) ───────────────────────────────────────────────────
# Cualquier proveedor que hable Chat Completions: Groq, OpenAI, OpenRouter, xAI, local.
# GROQ_* sigue valiendo como alias si no definís LLM_*.
LLM_API_KEY=your_api_key_here
LLM_MODEL=qwen/qwen3-32b
# Vacío = Groq (https://api.groq.com/openai/v1)
# OpenAI     → https://api.openai.com/v1
# OpenRouter → https://openrouter.ai/api/v1
# xAI        → https://api.x.ai/v1
LLM_BASE_URL=
LLM_VOICE_MODEL=whisper-large-v3-turbo
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3-32b

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# production → 127.0.0.1 (solo nginx). Local → 0.0.0.0
# LISTEN_HOST=127.0.0.1

# Token de /api (X-Aria-Token). Obligatorio si :3000 es alcanzable.
# openssl rand -hex 24
ARIA_API_TOKEN=
# Orígenes extra del panel (coma-separados). Vacío = same-origin.
# CORS_ORIGIN=http://localhost:5173

# ─── VenomBot ─────────────────────────────────────────────────────────────────
VENOM_SESSION=aria
VENOM_BROWSER=chrome   # chrome | edge | chromium

# ─── Base de datos (Fase 2) ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/aria
